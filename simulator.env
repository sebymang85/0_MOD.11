# SIMULATOR CONFIGURATION - PARAMETRI MODIFICABILI
DATA_BASE_DIR=data/historical
DATA_MEMMAP_DIR=data/memmap

VOLUME_LOOKBACK=4
VOLUME_THRESHOLD=101

VOLUME_THRESHOLD_MAX=1000000000000000000000
PRICE_INCREASE_WINDOW=288
SPIKE_COOLDOWN_CANDLES=24
MIN_PRICE_INCREASE_PERCENT=4
