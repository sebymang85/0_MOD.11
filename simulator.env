# Filtri opzionali sul price_ratio_at_spike (%) TAILS/RANGE
PRICE_RATIO_AT_SPIKE_MODE=TAILS
PRICE_RATIO_AT_SPIKE_MIN=-1000000000
PRICE_RATIO_AT_SPIKE_MAX=1000000000

# PERFORMANCE SETTINGS
